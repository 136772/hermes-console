# 工作台环境变量（方式 A：在飞牛宿主机上直接跑时用）
# 复制成 .env 后改掉 HERMES_DIR / DASH_DANGER_TOKEN 即可

# Hermes 数据目录（必须和 Hermes 容器挂的是同一份！）
HERMES_DIR=/path/to/hermes/data

# 怎么跟 Hermes 对话：docker=用 docker exec 敲容器 | local=宿主机有 hermes 命令
HERMES_MODE=docker
HERMES_CONTAINER=hermes

# 你给 Hermes 设的配额（MB），用于算百分比/告警阈值
QUOTA_MB=10240

# 对话超时（秒），复杂任务调 300
CHAT_TIMEOUT=180

# 巡检脚本目录
SCRIPT_DIR=/path/to/hermes-console

TZ=Asia/Shanghai

# 配置中心：1=只读（只监控），0=可改
DASH_READ_ONLY=0

# 危险动作令牌：重启/升级必须填对，强烈建议设置一个长随机串
DASH_DANGER_TOKEN=改成你自己的长随机串

# Hermes 的 compose 目录（升级按钮用）
COMPOSE_DIR=/path/to/hermes-compose

# 预算（元），0=不限制；超 80% 预警 / 100% 告警
BUDGET_DAILY=0
BUDGET_MONTHLY=0

# 告警巡检间隔（秒）
ALERT_INTERVAL=600

# 监听端口
PORT=8080

# ============ 登录鉴权（安全优先，默认开启） ============
# 关掉鉴权设 0（仅限完全隔离的局域网/调试）。部署后首个密码会写到
# HERMES_DIR 下的 DASHBOARD_PASSWORD.txt，首次登录强制修改。
DASH_AUTH=1
# 会话有效期（小时），默认 24
SESSION_HOURS=24
# 走 HTTPS 反代时设 1，让 Cookie 只走加密通道
DASH_SECURE_COOKIE=0

# ============ 可持续升级 ============
# 工作台自更新（git pull）用的远端仓库 owner/repo；配了才会在「系统」页比对上游版本。
# 容器内部署请用 docker compose pull + up -d，不必配这个。
UPDATE_REPO=

# ============ 官方仪表盘代理 ============
# Hermes 官方 Web 仪表盘后端地址（hermes dashboard 启动后的 FastAPI 服务）
# 本地模式：http://127.0.0.1:9119
# Docker 模式（工作台也是容器）：用宿主机 IP 或共享 docker network
#   http://172.17.0.1:9119    （默认 docker0 网桥）
#   http://hermes:9119         （同 network 下用容器名）
HERMES_API=http://127.0.0.1:9119
# 官方后端认证 token（可选，官方后端开启认证时填）
HERMES_API_TOKEN=
# 代理转发超时（秒），默认 300
PROXY_TIMEOUT=300

